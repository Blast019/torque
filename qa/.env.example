# Copie este arquivo para qa/.env e preencha com valores reais.
# qa/.env é ignorado pelo Git (ver .gitignore na raiz) - nunca commitar.
#
# Rodar os scripts a partir da raiz do repositório com:
#   node --env-file=qa/.env qa/fase-2.5/scripts/NOME_DO_SCRIPT.js

# Projeto Supabase (URL base e chave anon do projeto de QA)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Senha compartilhada por todas as contas de teste de QA
SUPABASE_TEST_PASSWORD=

# Contas de teste de QA da Fase 2.5 (e-mails, não senhas)
QA_EMAIL_PROPRIETARIO=
QA_EMAIL_ADMIN=
QA_EMAIL_USUARIO=
QA_EMAIL_SEM_VINCULO=
QA_EMAIL_PROPRIETARIO_ANTIGO=
